{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  },
  "include": ["./**/*.js", "./**/*.ts", "./**/*.tsx"],
  "exclude": ["dist", ".sanity", "node_modules"]
}
